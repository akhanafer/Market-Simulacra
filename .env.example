# Copy this file to .env and fill in your key(s).
# The app reads the env var for the selected model's provider as the default;
# you can also override it per provider in the UI sidebar.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if you install the provider's SDK (uv add openai / google-genai):
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
