{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run streamlit:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) cd \"$CLAUDE_PROJECT_DIR\" && env -u VIRTUAL_ENV uv run ruff format \"$f\" && env -u VIRTUAL_ENV uv run ruff check --fix \"$f\" ;; esac; } >/dev/null 2>&1 || true",
            "statusMessage": "Formatting with ruff..."
          }
        ]
      }
    ]
  }
}
